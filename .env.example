# ---------- server ----------
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://audits.yourdomain.com
API_KEYS=change-me-key-1,change-me-key-2
REQUIRE_AUTH=true

# ---------- storage ----------
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/seoagent.db
# DATABASE_URL=postgresql+psycopg://user:pass@postgres:5432/seoagent

# ---------- crawl ----------
MAX_PAGES=10
CRAWL_CONCURRENCY=5
REQUEST_TIMEOUT=20
PER_HOST_DELAY_MS=250
RESPECT_ROBOTS=true
MAX_LINK_CHECKS=120
USER_AGENT=Mozilla/5.0 (compatible; SEOAuditAgent/1.0; +https://yourdomain.com/bot)

# ---------- throughput (500 audits/day sits comfortably here) ----------
WORKER_COUNT=4
DAILY_AUDIT_QUOTA=500
AUDIT_TIMEOUT_SEC=600

# ---------- features ----------
SCREENSHOTS_ENABLED=true
SCREENSHOT_MAX=12
COMPETITORS_ENABLED=true
COMPETITOR_COUNT=3
PDF_ENABLED=true

# ---------- stateless mode ----------
# true  = nothing is stored. POST /audit.pdf returns the PDF and the server keeps
#         no database row, no report file and no screenshots. History endpoints
#         and share links are disabled (they return 409).
# false = normal mode with saved audits, share links and the dashboard.
STATELESS=false

# ---------- public link mode ----------
# REQUIRE_AUTH=false turns the home page into a public audit form anyone can use.
# These limits only apply when REQUIRE_AUTH=false.
RATE_LIMIT_PER_HOUR=5
PUBLIC_MAX_PAGES=8
REPORT_CACHE_MINUTES=30
REPORT_CACHE_MAX=25

# ---------- optional providers (each one upgrades a section from estimate to measured) ----------
# Real Core Web Vitals + Lighthouse opportunities
PAGESPEED_API_KEY=
# Competitor discovery from live Google results (either one)
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# LLM assist: service/keyword refinement, executive summary, live AI-citation check
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Backlink / authority data
OPENPAGERANK_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
